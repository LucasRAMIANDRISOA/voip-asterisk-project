[general]

[default_bridge]
type=bridge
max_members=10
record_conference=no
internal_sample_rate=auto
mixing_interval=20

[default_user]
type=user
admin=no
marked=no
music_on_hold_when_empty=yes
quiet=no
announce_user_count=yes
announce_user_count_all=no
announce_only_user=yes

[admin_user](default_user)
admin=yes
marked=yes
